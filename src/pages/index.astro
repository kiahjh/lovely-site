---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
	<div class="flex flex-col items-center justify-center min-h-screen bg-amber-700/10 p-4">
		<h1 class="text-5xl text-amber-900">lovely</h1>
		<h2 class="text-lg mt-4 text-amber-800/80 text-center">a delightful low-level systems programming language ❤️</h2>
		<h3 class="mt-8 bg-amber-900/15 font-mono text-lg text-amber-900 font-bold px-2 py-0.5 rounded-xl"><span class="text-base font-normal opacity-60">$</span> cargo install lovely</h3>
		<a href="https://github.com/kiahjh/lovely" class="mt-8 text-amber-900 underline">github</a>
	</div>
</BaseLayout>
